{
 "suite": "raylib",
 "about": "What a C program does with raylib (raylib.com), what Tsoding's musializer and panim draw and play sound with (github.com/tsoding). Each query names raylib, as someone looking for raylib code would. Expected identifiers are the raylib calls a working answer cannot do without; `source` is a file that makes them all: musializer's or panim's, else an example raylib ships.",
 "intents": [
  {"id": "window-loop", "query": "open a raylib window and draw frames until it is closed", "languages": ["c", "cpp"], "expect": ["InitWindow", "WindowShouldClose", "BeginDrawing", "EndDrawing"], "source": "https://github.com/tsoding/panim/blob/ead3829ea7fcd6c1fcfa1ea011216b614ab3089c/panim/panim.c"},
  {"id": "texture", "query": "load an image as a raylib texture and draw it", "languages": ["c", "cpp"], "expect": ["LoadTexture", "DrawTexture|DrawTextureEx|DrawTexturePro"], "source": "https://github.com/tsoding/panim/blob/ead3829ea7fcd6c1fcfa1ea011216b614ab3089c/plugs/tm/plug.c"},
  {"id": "render-texture", "query": "draw into an offscreen raylib render texture and then draw it scaled", "languages": ["c", "cpp"], "expect": ["LoadRenderTexture", "BeginTextureMode", "DrawTexturePro|DrawTextureRec|DrawTextureEx"], "source": "https://github.com/tsoding/musializer/blob/4d7d2fa849ef66e94ce03a53a2e7aa3e36aa2392/src/plug.c"},
  {"id": "shader", "query": "draw with a custom fragment shader in raylib and set its uniform", "languages": ["c", "cpp"], "expect": ["LoadShader|LoadShaderFromMemory", "SetShaderValue", "BeginShaderMode"], "source": "https://github.com/tsoding/musializer/blob/4d7d2fa849ef66e94ce03a53a2e7aa3e36aa2392/src/plug.c"},
  {"id": "sound", "query": "load a sound with raylib and play it when a key is pressed", "languages": ["c", "cpp"], "expect": ["LoadSound", "PlaySound", "IsKeyPressed"], "source": "https://github.com/raysan5/raylib/blob/d6cb247ca7d3e3adc2b2845492ded642a2305046/examples/audio/audio_sound_loading.c"},
  {"id": "music-stream", "query": "stream music from a file with raylib and keep its buffer filled", "languages": ["c", "cpp"], "expect": ["LoadMusicStream", "UpdateMusicStream"], "source": "https://github.com/tsoding/musializer/blob/4d7d2fa849ef66e94ce03a53a2e7aa3e36aa2392/src/plug.c"},
  {"id": "audio-callback", "query": "generate audio samples in a callback for a raylib audio stream", "languages": ["c", "cpp"], "expect": ["SetAudioStreamCallback|UpdateAudioStream", "LoadAudioStream"], "source": "https://github.com/raysan5/raylib/blob/d6cb247ca7d3e3adc2b2845492ded642a2305046/examples/audio/audio_raw_stream.c"},
  {"id": "music-fft", "query": "read the samples of music playing in raylib to draw its spectrum", "languages": ["c", "cpp"], "expect": ["AttachAudioStreamProcessor|AttachAudioMixedProcessor"], "source": "https://github.com/tsoding/musializer/blob/4d7d2fa849ef66e94ce03a53a2e7aa3e36aa2392/src/plug.c"},
  {"id": "camera-2d", "query": "follow the player with a raylib 2D camera and zoom with the mouse wheel", "languages": ["c", "cpp"], "expect": ["Camera2D", "BeginMode2D", "GetMouseWheelMove"], "source": "https://github.com/raysan5/raylib/blob/d6cb247ca7d3e3adc2b2845492ded642a2305046/examples/core/core_2d_camera_mouse_zoom.c"},
  {"id": "camera-3d", "query": "draw a 3D scene with an orbiting raylib camera", "languages": ["c", "cpp"], "expect": ["Camera3D|Camera", "BeginMode3D", "UpdateCamera"], "source": "https://github.com/raysan5/raylib/blob/d6cb247ca7d3e3adc2b2845492ded642a2305046/examples/models/models_billboard_rendering.c"},
  {"id": "text", "query": "load a font in raylib and draw text centered on the screen", "languages": ["c", "cpp"], "expect": ["LoadFontEx|LoadFont", "MeasureTextEx", "DrawTextEx"], "source": "https://github.com/tsoding/panim/blob/ead3829ea7fcd6c1fcfa1ea011216b614ab3089c/panim/panim.c"},
  {"id": "drop-files", "query": "load the files dropped onto a raylib window", "languages": ["c", "cpp"], "expect": ["IsFileDropped", "LoadDroppedFiles"], "source": "https://github.com/tsoding/musializer/blob/4d7d2fa849ef66e94ce03a53a2e7aa3e36aa2392/src/plug.c"},
  {"id": "collision", "query": "check whether two rectangles collide in raylib", "languages": ["c", "cpp"], "expect": ["CheckCollisionRecs"], "source": "https://github.com/raysan5/raylib/blob/d6cb247ca7d3e3adc2b2845492ded642a2305046/examples/shapes/shapes_collision_area.c"},
  {"id": "image-pixels", "query": "change the pixels of a raylib image on the CPU and upload it to a texture", "languages": ["c", "cpp"], "expect": ["LoadImageColors|GetImageColor|ImageDrawPixel", "UpdateTexture|LoadTextureFromImage"], "source": "https://github.com/raysan5/raylib/blob/d6cb247ca7d3e3adc2b2845492ded642a2305046/examples/textures/textures_image_processing.c"},
  {"id": "screenshot-frames", "query": "read back what raylib rendered to save the frames of a video", "languages": ["c", "cpp"], "expect": ["LoadImageFromTexture|rlReadScreenPixels|LoadImageFromScreen"], "source": "https://github.com/tsoding/musializer/blob/4d7d2fa849ef66e94ce03a53a2e7aa3e36aa2392/src/plug.c"}
 ]
}
