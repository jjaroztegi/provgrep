{
 "suite": "languages",
 "about": "Common tasks in the languages a programmer like Tsoding writes in besides C (github.com/tsoding), each in its own language. Expected identifiers are the calls a working answer cannot do without, as each language's standard library or best-known package names them.",
 "intents": [
  {"id": "zig-read-file", "query": "read a whole file into memory", "languages": ["zig"], "expect": ["readToEndAlloc|readFileAlloc"]},
  {"id": "zig-array-list", "query": "append items to a growable list and free it", "languages": ["zig"], "expect": ["ArrayList", "append", "deinit"]},
  {"id": "zig-count-words", "query": "count occurrences of words with a string hash map", "languages": ["zig"], "expect": ["StringHashMap|StringArrayHashMap", "getOrPut"]},
  {"id": "zig-arena", "query": "allocate with an arena and free it all at once", "languages": ["zig"], "expect": ["ArenaAllocator"]},
  {"id": "odin-raylib-window", "query": "open a raylib window and draw until it is closed", "languages": ["odin"], "expect": ["InitWindow", "WindowShouldClose", "BeginDrawing"]},
  {"id": "odin-read-file", "query": "read a whole file", "languages": ["odin"], "expect": ["read_entire_file|read_entire_file_from_filename"]},
  {"id": "nim-http-get", "query": "download a web page with an HTTP client", "languages": ["nim"], "expect": ["newHttpClient|newAsyncHttpClient", "getContent"]},
  {"id": "nim-json", "query": "parse a JSON string and read a field", "languages": ["nim"], "expect": ["parseJson"]},
  {"id": "d-read-lines", "query": "read a file line by line", "languages": ["d"], "expect": ["byLine"]},
  {"id": "d-json", "query": "parse a JSON document", "languages": ["d"], "expect": ["parseJSON"]},
  {"id": "ada-read-lines", "query": "read a text file line by line", "languages": ["ada"], "expect": ["Get_Line", "Open"]},
  {"id": "ada-random", "query": "random integer in a range", "languages": ["ada"], "expect": ["Discrete_Random"]},
  {"id": "pascal-read-lines", "query": "read a text file line by line", "languages": ["pascal"], "expect": ["ReadLn|Readln|readln", "AssignFile|Assign|assign"]},
  {"id": "pascal-string-list", "query": "load a text file into a string list", "languages": ["pascal"], "expect": ["TStringList", "LoadFromFile"]},
  {"id": "fortran-allocate", "query": "allocate an array whose size is known at run time", "languages": ["fortran"], "expect": ["allocate|ALLOCATE"]},
  {"id": "fortran-mpi-sum", "query": "sum a value across all MPI processes", "languages": ["fortran"], "expect": ["MPI_Reduce|MPI_Allreduce|mpi_reduce|mpi_allreduce|MPI_REDUCE|MPI_ALLREDUCE"]},
  {"id": "erlang-gen-server", "query": "a gen_server that keeps state and answers synchronous calls", "languages": ["erlang"], "expect": ["handle_call", "reply"]},
  {"id": "erlang-tcp-accept", "query": "accept TCP connections in a loop", "languages": ["erlang"], "expect": ["gen_tcp", "accept"]},
  {"id": "erlang-ets", "query": "store key value pairs in an ETS table and look them up", "languages": ["erlang"], "expect": ["ets", "insert", "lookup"]},
  {"id": "haskell-count-lines", "query": "read a file and count its lines", "languages": ["haskell"], "expect": ["readFile|getContents", "lines"]},
  {"id": "haskell-state", "query": "keep a counter in the State monad", "languages": ["haskell"], "expect": ["modify|modify'", "runState|evalState|execState"]},
  {"id": "haskell-word-count", "query": "count words with Data.Map", "languages": ["haskell"], "expect": ["insertWith|fromListWith"]},
  {"id": "haskell-stm", "query": "share a counter between threads with STM", "languages": ["haskell"], "expect": ["TVar|newTVarIO|newTVar", "atomically"]},
  {"id": "ocaml-read-lines", "query": "read all lines of a file", "languages": ["ocaml"], "expect": ["input_line", "End_of_file"]},
  {"id": "ocaml-word-count", "query": "count words with a hash table", "languages": ["ocaml"], "expect": ["Hashtbl", "replace|add", "find_opt|find"]},
  {"id": "lua-read-file", "query": "read a whole file into a string", "languages": ["lua"], "expect": ["io.open", "read"]},
  {"id": "lua-love-draw", "query": "draw a rectangle every frame in LÖVE", "languages": ["lua"], "expect": ["love.graphics.rectangle"]},
  {"id": "lua-class", "query": "a class with a metatable and __index", "languages": ["lua"], "expect": ["setmetatable", "__index"]},
  {"id": "lua-split", "query": "split a string on a separator", "languages": ["lua"], "expect": ["gmatch"]},
  {"id": "julia-csv", "query": "read a CSV file into a DataFrame", "languages": ["julia"], "expect": ["CSV", "DataFrame"]},
  {"id": "julia-threads", "query": "run a loop on several threads", "languages": ["julia"], "expect": ["@threads|Threads.@threads"]},
  {"id": "julia-ode", "query": "solve an ordinary differential equation", "languages": ["julia"], "expect": ["ODEProblem", "solve"]},
  {"id": "vala-gtk-window", "query": "a GTK application window with a button", "languages": ["vala"], "expect": ["Gtk.Application|Gtk.ApplicationWindow", "Gtk.Button"]},
  {"id": "racket-read-file", "query": "read a whole file into a string", "languages": ["racket"], "expect": ["file->string|port->string"]},
  {"id": "racket-word-count", "query": "count words with a hash table", "languages": ["racket"], "expect": ["hash-update!"]},
  {"id": "lisp-read-lines", "query": "read a file line by line", "languages": ["commonlisp"], "expect": ["with-open-file", "read-line"]},
  {"id": "lisp-word-count", "query": "count words with a hash table", "languages": ["commonlisp"], "expect": ["gethash", "make-hash-table"]},
  {"id": "glsl-phong", "query": "Phong lighting from a normal and a light direction", "languages": ["glsl"], "expect": ["reflect", "normalize", "dot"]},
  {"id": "glsl-circle", "query": "draw a smooth circle with a signed distance in a fragment shader", "languages": ["glsl"], "expect": ["smoothstep", "length"]},
  {"id": "jai-read-file", "query": "read a whole file", "languages": ["jai"], "expect": ["read_entire_file"]}
 ]
}
